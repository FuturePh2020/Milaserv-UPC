{% assign is_en = false %}{% if lang == "en" %}{% assign is_en = true %}{% endif %}
{% if slides.size > 0 %}
<section class="bp-theme bp-slider" aria-roledescription="carousel" aria-label="{% if is_en %}Featured offers{% else %}عروض مميزة{% endif %}" data-autoplay="5000">
  <div class="bp-container">
    <div class="bp-slider__frame">
      <div class="bp-slider__track">
        {% for slide in slides %}
          {% capture slide_img %}
            <picture>
              {% if slide.mobile_image != blank %}
                <source media="(max-width: 425px)" srcset="{{ slide.mobile_image }}">
                <source media="(min-width: 426px)" srcset="{{ slide.image }}">
              {% endif %}
              <img src="{{ slide.image }}" alt="{{ slide.alt | default: '' }}" width="1600" height="600" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %} decoding="async">
            </picture>
          {% endcapture %}
          {% if slide.url != blank %}
            <a class="bp-slider__slide" href="{{ slide.url }}" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}{% if slide.alt != blank %}: {{ slide.alt }}{% endif %}">{{ slide_img }}</a>
          {% else %}
            <div class="bp-slider__slide" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}">{{ slide_img }}</div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% if slides.size > 1 %}
      <div class="bp-slider__dots">
        {% for slide in slides %}
          <button type="button" class="bp-slider__dot" data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{% if is_en %}Go to slide {{ forloop.index }}{% else %}اعرض الشريحة {{ forloop.index }}{% endif %}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endif %}
