{% comment %} GENERATED from tools/src-home/bp-gift-box-promo.liquid by tools/build-sections.py - edit the source, not this file. {% endcomment %}
{% assign hs_key = "giftpromo" %}{% assign hs_default_surface = "mint" %}{% assign hs_class = "bp-giftpromo" %}{% assign hs_style = "" %}
{%- assign is_en = false -%}{%- if lang == "en" -%}{%- assign is_en = true -%}{%- endif -%}
{%- assign sd = section_data -%}
{%- assign sid = section_id | default: hs_key -%}
{%- assign surface = sd.surface | default: hs_default_surface -%}
{%- assign cur = currency -%}
{%- if is_en and theme_data.currency_display_en != blank -%}{%- assign cur = theme_data.currency_display_en -%}{%- elsif is_en == false and theme_data.currency_display != blank -%}{%- assign cur = theme_data.currency_display -%}{%- endif -%}
{%- assign oos_label = theme_data.out_of_stock_label | default: "نفدت الكمية" -%}
{%- assign anchor = sd.anchor_id | default: "" | strip | remove: "#" | replace: " ", "-" -%}
{%- assign hs_title = sd.title -%}{%- assign hs_sub = sd.subtitle -%}{%- assign hs_hl = sd.title_highlight | strip -%}
{%- if is_en -%}
  {%- if sd.title_en != blank -%}{%- assign hs_title = sd.title_en -%}{%- assign hs_hl = "" -%}{%- endif -%}
  {%- if sd.subtitle_en != blank -%}{%- assign hs_sub = sd.subtitle_en -%}{%- endif -%}
{%- endif -%}
{% if hs_title != blank %}
<section class="bp-theme bp-section bp-surface--{{ surface }} {{ hs_class }}{% if sd.wave_top %} bp-has-wave{% endif %}{% if sd.hide_on_mobile %} bp-hide-sm{% endif %}"{% if anchor != "" %} id="{{ anchor }}"{% endif %}{% if hs_title != blank %} aria-labelledby="bp-h-{{ sid }}"{% endif %} data-bp-currency="{{ cur }}" style="{% if surface == 'custom' %}--bp-surface-bg: {{ sd.bg_custom | default: '#ffffff' }};{% if sd.text_light %}--bp-surface-fg: #ffffff;{% endif %}{% endif %}{{ hs_style }}">
  {%- if sd.wave_top -%}<svg class="bp-wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 40V22c80-14 160-20 240-8s160 20 240 8 160-24 240-14 160 26 240 16 160-24 240-16 160 20 240 12v22z"/></svg>{%- endif -%}
  <div class="bp-container bp-giftpromo__grid">
    <div>
<div class="bp-section-head__text">
  {%- if sd.kicker != blank -%}<p class="bp-kicker">{{ sd.kicker }}</p>{%- endif -%}
  {%- if hs_title != blank -%}
    <h2 class="bp-h2" id="bp-h-{{ sid }}">
      {%- if hs_hl != "" and hs_title contains hs_hl -%}
        {%- assign hl_html = '<span class="bp-hl">' | append: hs_hl | append: '</span>' -%}
        {{ hs_title | replace_first: hs_hl, hl_html }}
      {%- else -%}{{ hs_title }}{%- endif -%}
    </h2>
  {%- endif -%}
  {%- if hs_sub != blank -%}<p class="bp-lead">{{ hs_sub }}</p>{%- endif -%}
</div>
      <ol class="bp-giftpromo__steps">
        {% assign n_steps = 0 %}
        {% for st in sd.steps %}{% if st.text != blank %}{% assign n_steps = n_steps | plus: 1 %}<li>{{ st.text }}</li>{% endif %}{% endfor %}
        {% if n_steps == 0 %}
          {% if is_en %}
            <li>Pick the items you love</li><li>Choose your packaging</li><li>Add the whole box to your cart</li>
          {% else %}
            <li>اختار الحاجات اللي بتحبها</li><li>اختار شكل التغليف</li><li>ضيف البوكس كله للسلة مرة واحدة</li>
          {% endif %}
        {% endif %}
      </ol>
      <div class="bp-hero__ctas">
        {% assign lk = "cta" %}{% assign lk_class = "bp-btn bp-btn--ink" %}
{%- comment -%} expects lk (field prefix), lk_class {%- endcomment -%}
{%- assign k = lk | append: "_label" -%}{%- assign lk_label = sd[k] -%}
{%- if is_en -%}{%- assign k = lk | append: "_label_en" -%}{%- if sd[k] != blank -%}{%- assign lk_label = sd[k] -%}{%- endif -%}{%- endif -%}
{%- assign k = lk | append: "_link_type" -%}{%- assign lk_type = sd[k] | default: "category" -%}
{%- assign lk_href = "" -%}{%- assign lk_ent = "categories" -%}{%- assign lk_id = "" -%}
{%- case lk_type -%}
  {%- when "url" -%}{%- assign k = lk | append: "_url" -%}{%- assign lk_href = sd[k] | default: "" | strip -%}
  {%- when "product" -%}{%- assign lk_ent = "products" -%}{%- assign k = lk | append: "_product_id" -%}{%- assign lk_id = sd[k] -%}
  {%- when "page" -%}{%- assign lk_ent = "pages" -%}{%- assign k = lk | append: "_page_id" -%}{%- assign lk_id = sd[k] -%}
  {%- else -%}{%- assign k = lk | append: "_category_id" -%}{%- assign lk_id = sd[k] -%}
{%- endcase -%}
{%- if lk_label != blank -%}
  {%- if lk_href != "" -%}
    <a class="{{ lk_class }}" href="{{ lk_href }}">{{ lk_label }}</a>
  {%- elsif lk_id != blank -%}
    <a class="{{ lk_class }}" data-bp-link-entity="{{ lk_ent }}" data-bp-link-id="{{ lk_id }}">{{ lk_label }}</a>
  {%- endif -%}
{%- endif -%}
      </div>
    </div>
    <div class="bp-giftpromo__art" aria-hidden="true">
      {% if sd.box_image != blank %}
        <img src="{{ sd.box_image }}" alt="" width="560" height="480" loading="lazy" style="width:100%;height:100%;object-fit:contain">
      {% else %}
        <div class="bp-giftpromo__box"></div>
        {% if sd.image_1 != blank %}<img class="bp-giftpromo__img" src="{{ sd.image_1 }}" alt="" width="200" height="200" loading="lazy">{% endif %}
        {% if sd.image_2 != blank %}<img class="bp-giftpromo__img" src="{{ sd.image_2 }}" alt="" width="200" height="200" loading="lazy">{% endif %}
        {% if sd.image_3 != blank %}<img class="bp-giftpromo__img" src="{{ sd.image_3 }}" alt="" width="200" height="200" loading="lazy">{% endif %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
