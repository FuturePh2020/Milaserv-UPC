{
  "icon": "https://api.iconify.design/lucide:package.svg",
  "label": "Bazaar Pop: الجملة / الكراتين",
  "section_schema": [
    {
      "name": "kicker",
      "type": "string",
      "description": "سطر صغير فوق العنوان (اختياري)",
      "default": "📦 الجملة",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title",
      "type": "string",
