      "options": [
        {
          "label": "كريمي",
          "value": "cream"
        },
        {
          "label": "أزرق",
          "value": "blue"
        },
        {
          "label": "أصفر",
          "value": "yellow"
        },
        {
          "label": "وردي",
          "value": "pink"
        },
        {
          "label": "نعناعي",
          "value": "mint"
        },
        {
          "label": "سماوي",
          "value": "sky"
        },
        {
          "label": "كحلي غامق",
          "value": "ink"
        },
        {
          "label": "أبيض",
          "value": "white"
        },
        {
          "label": "لون مخصص ↓",
          "value": "custom"
        }
