        {
          "name": "name",
          "type": "string",
          "description": "اسم الشريحة",
          "default": "شريحة 1"
        },
        {
          "name": "quantity",
          "type": "string",
          "description": "الكمية/الحد الأدنى، مثال: من 3 كراتين",
          "default": "من 3 كراتين"
        },
        {
          "name": "unit_note",
          "type": "string",
          "description": "توضيح الوحدة، مثال: الكرتونة = 24 علبة",
          "default": ""
        },
        {
          "name": "price_note",
          "type": "string",
          "description": "ملاحظة السعر، مثال: سعر خاص بيتأكد مع خدمة العملاء",
