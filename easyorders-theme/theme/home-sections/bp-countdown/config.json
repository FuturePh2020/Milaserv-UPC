{
  "icon": "https://api.iconify.design/lucide:timer.svg",
  "label": "Bazaar Pop: عدّ تنازلي (وصول جديد)",
  "section_schema": [
    {
      "name": "kicker",
      "type": "string",
      "description": "سطر صغير فوق العنوان (اختياري)",
      "default": "⏳ قريباً",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title",
      "type": "string",
      "description": "العنوان",
      "default": "وصل قريب!",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title_highlight",
      "type": "string",
      "description": "جزء من العنوان يتلوّن بالماركر (لازم يكون موجود في العنوان بالظبط)",
      "default": "قريب",
      "group": "العنوان (Heading)"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "وصف قصير",
      "default": "شحنة جديدة في الطريق.",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title_en",
      "type": "string",
      "description": "Title (English, optional)",
      "default": "",
      "group": "العنوان (Heading)"
    },
    {
      "name": "subtitle_en",
      "type": "string",
      "description": "Subtitle (English, optional)",
      "default": "",
      "group": "العنوان (Heading)"
    },
    {
      "name": "target_datetime",
      "type": "string",
      "description": "ميعاد الوصول الحقيقي بالصيغة YYYY-MM-DD HH:mm (مثال: 2026-12-01 20:00)",
      "default": "",
      "group": "الميعاد (Date)"
    },
    {
      "name": "timezone",
      "type": "select",
      "description": "المنطقة الزمنية",
      "default": "Africa/Cairo",
      "options": [
        {
          "label": "القاهرة",
          "value": "Africa/Cairo"
        },
        {
          "label": "الرياض",
          "value": "Asia/Riyadh"
        },
        {
          "label": "دبي",
          "value": "Asia/Dubai"
        },
        {
          "label": "UTC",
          "value": "UTC"
        }
      ],
      "group": "الميعاد (Date)"
    },
    {
      "name": "date_label",
      "type": "string",
      "description": "الميعاد بالكلام (يظهر حتى بدون جافاسكربت)، مثال: الإثنين 1 ديسمبر الساعة 8 مساءً",
      "default": "",
      "group": "الميعاد (Date)"
    },
    {
      "name": "expired_behavior",
      "type": "select",
      "description": "بعد انتهاء العد",
      "default": "message",
      "options": [
        {
          "label": "اعرض رسالة",
          "value": "message"
        },
        {
          "label": "اخفي السكشن",
          "value": "hide"
        }
      ],
      "group": "الميعاد (Date)"
    },
    {
      "name": "expired_message",
      "type": "string",
      "description": "رسالة بعد الانتهاء",
      "default": "وصلت! اتفرج على الجديد 👇",
      "group": "الميعاد (Date)"
    },
    {
      "name": "product_ids",
      "type": "product_multi_select",
      "description": "منتجات قادمة (اختياري)",
      "group": "الميعاد (Date)"
    },
    {
      "name": "image",
      "type": "image",
      "description": "صورة (اختياري)",
      "default": "",
      "group": "الميعاد (Date)"
