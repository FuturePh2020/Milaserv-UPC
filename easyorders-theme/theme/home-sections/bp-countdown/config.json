      "description": "المنتج",
      "group": "الزرار الأساسي"
    },
    {
      "name": "cta_page_id",
      "type": "page_single_select",
      "description": "الصفحة",
      "group": "الزرار الأساسي"
    },
    {
      "name": "cta_url",
      "type": "string",
      "description": "الرابط المكتوب (مثال: /collections/snacks أو /#gift-box)",
      "default": "",
      "group": "الزرار الأساسي"
    },
    {
      "name": "surface",
      "type": "select",
      "description": "خلفية السكشن",
      "default": "ink",
      "options": [
        {
          "label": "كريمي",
          "value": "cream"
        },
        {
          "label": "أزرق",
          "value": "blue"
        },
        {
          "label": "أصفر",
          "value": "yellow"
        },
        {
          "label": "وردي",
          "value": "pink"
        },
        {
          "label": "نعناعي",
          "value": "mint"
        },
        {
          "label": "سماوي",
          "value": "sky"
        },
        {
          "label": "كحلي غامق",
          "value": "ink"
        },
        {
          "label": "أبيض",
          "value": "white"
        },
        {
          "label": "لون مخصص ↓",
          "value": "custom"
        }
      ],
      "group": "الشكل (Look)"
    },
    {
      "name": "bg_custom",
      "type": "color",
      "description": "اللون المخصص (لو اخترت لون مخصص)",
      "default": "#FFFFFF",
      "group": "الشكل (Look)"
    },
    {
      "name": "text_light",
      "type": "boolean",
      "description": "نص فاتح (للخلفيات الغامقة المخصصة)",
      "default": false,
      "group": "الشكل (Look)"
    },
    {
      "name": "wave_top",
      "type": "boolean",
      "description": "حافة متموجة أعلى السكشن",
      "default": true,
      "group": "الشكل (Look)"
    },
    {
      "name": "anchor_id",
      "type": "string",
      "description": "معرّف للرابط المباشر بدون # (مثال: gift-box ← الرابط /#gift-box)",
      "default": "",
      "group": "الشكل (Look)"
    },
    {
      "name": "hide_on_mobile",
      "type": "boolean",
      "description": "إخفاء السكشن على الموبايل",
      "default": false,
      "group": "الشكل (Look)"
    }
