      "options": [
        {
          "label": "قسم",
          "value": "category"
        },
        {
          "label": "منتج",
          "value": "product"
        },
        {
          "label": "صفحة",
          "value": "page"
        },
        {
          "label": "رابط مكتوب",
          "value": "url"
        }
      ],
      "group": "الزرار الأساسي"
    },
    {
      "name": "cta_category_id",
      "type": "category_single_select",
