{
  "icon": "https://api.iconify.design/lucide:heart-handshake.svg",
  "label": "Bazaar Pop: قسم مميز (العناية مثلاً)",
  "section_schema": [
    {
      "name": "kicker",
      "type": "string",
      "description": "سطر صغير فوق العنوان (اختياري)",
      "default": "💄 ركن العناية",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title",
      "type": "string",
      "description": "العنوان",
      "default": "عناية وجمال",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title_highlight",
      "type": "string",
      "description": "جزء من العنوان يتلوّن بالماركر (لازم يكون موجود في العنوان بالظبط)",
      "default": "جمال",
      "group": "العنوان (Heading)"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "وصف قصير",
      "default": "منتجات عناية مختارة بعناية.",
      "group": "العنوان (Heading)"
    },
    {
      "name": "title_en",
      "type": "string",
      "description": "Title (English, optional)",
      "default": "",
      "group": "العنوان (Heading)"
    },
    {
      "name": "subtitle_en",
      "type": "string",
      "description": "Subtitle (English, optional)",
      "default": "",
      "group": "العنوان (Heading)"
    },
    {
      "name": "image",
      "type": "image",
      "description": "صورة جانبية (اختياري)",
      "default": "",
      "group": "المحتوى (Content)"
    },
    {
      "name": "chips",
      "type": "object_array",
      "description": "روابط الأقسام الفرعية",
      "group": "المحتوى (Content)",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "description": "النص",
          "default": "سكين كير"
        },
        {
          "name": "link_url",
          "type": "string",
          "description": "رابط مكتوب (اختياري، له الأولوية)",
          "default": ""
        },
        {
          "name": "category_id",
          "type": "category_single_select",
          "description": "أو اختار قسم"
        }
      ]
    },
    {
      "name": "product_ids",
      "type": "product_multi_select",
      "description": "المنتجات المعروضة",
      "group": "المحتوى (Content)"
    },
    {
      "name": "cta_label",
      "type": "string",
      "description": "نص الزرار (فاضي = بدون زرار)",
      "default": "شوف الكل",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_label_en",
      "type": "string",
      "description": "Button label (English)",
      "default": "",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_link_type",
      "type": "select",
      "description": "الزرار يودّي على",
      "default": "category",
      "options": [
        {
          "label": "قسم",
          "value": "category"
        },
        {
          "label": "منتج",
          "value": "product"
        },
        {
          "label": "صفحة",
          "value": "page"
        },
        {
          "label": "رابط مكتوب",
          "value": "url"
        }
      ],
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_category_id",
      "type": "category_single_select",
      "description": "القسم",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_product_id",
      "type": "product_single_select",
      "description": "المنتج",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_page_id",
      "type": "page_single_select",
      "description": "الصفحة",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "cta_url",
      "type": "string",
      "description": "الرابط المكتوب (مثال: /collections/snacks أو /#gift-box)",
      "default": "",
      "group": "الزرار شوف الكل"
    },
    {
      "name": "surface",
      "type": "select",
      "description": "خلفية السكشن",
      "default": "pink",
      "options": [
        {
          "label": "كريمي",
          "value": "cream"
        },
        {
          "label": "أزرق",
          "value": "blue"
        },
        {
          "label": "أصفر",
          "value": "yellow"
        },
        {
          "label": "وردي",
          "value": "pink"
        },
        {
          "label": "نعناعي",
          "value": "mint"
        },
        {
          "label": "سماوي",
          "value": "sky"
        },
        {
          "label": "كحلي غامق",
          "value": "ink"
        },
        {
          "label": "أبيض",
          "value": "white"
        },
        {
          "label": "لون مخصص ↓",
          "value": "custom"
        }
      ],
      "group": "الشكل (Look)"
    },
    {
      "name": "bg_custom",
      "type": "color",
      "description": "اللون المخصص (لو اخترت لون مخصص)",
      "default": "#FFFFFF",
      "group": "الشكل (Look)"
    },
    {
      "name": "text_light",
      "type": "boolean",
      "description": "نص فاتح (للخلفيات الغامقة المخصصة)",
      "default": false,
      "group": "الشكل (Look)"
    },
    {
      "name": "wave_top",
      "type": "boolean",
      "description": "حافة متموجة أعلى السكشن",
      "default": true,
      "group": "الشكل (Look)"
    },
    {
      "name": "anchor_id",
      "type": "string",
      "description": "معرّف للرابط المباشر بدون # (مثال: gift-box ← الرابط /#gift-box)",
      "default": "",
      "group": "الشكل (Look)"
    },
    {
      "name": "hide_on_mobile",
      "type": "boolean",
      "description": "إخفاء السكشن على الموبايل",
      "default": false,
      "group": "الشكل (Look)"
    }
  ]
}
