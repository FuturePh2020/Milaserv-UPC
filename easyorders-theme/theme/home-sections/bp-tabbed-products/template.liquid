{% comment %} GENERATED from tools/src-home/bp-tabbed-products.liquid by tools/build-sections.py - edit the source, not this file. {% endcomment %}
{% assign hs_key = "tabs" %}{% assign hs_default_surface = "sky" %}{% assign hs_class = "bp-pets" %}{% assign hs_style = "" %}
{%- assign is_en = false -%}{%- if lang == "en" -%}{%- assign is_en = true -%}{%- endif -%}
{%- assign sd = section_data -%}
{%- assign sid = section_id | default: hs_key -%}
{%- assign surface = sd.surface | default: hs_default_surface -%}
{%- assign cur = currency -%}
{%- if is_en and theme_data.currency_display_en != blank -%}{%- assign cur = theme_data.currency_display_en -%}{%- elsif is_en == false and theme_data.currency_display != blank -%}{%- assign cur = theme_data.currency_display -%}{%- endif -%}
{%- assign oos_label = theme_data.out_of_stock_label | default: "نفدت الكمية" -%}
{%- assign anchor = sd.anchor_id | default: "" | strip | remove: "#" | replace: " ", "-" -%}
{%- assign hs_title = sd.title -%}{%- assign hs_sub = sd.subtitle -%}{%- assign hs_hl = sd.title_highlight | strip -%}
{%- if is_en -%}
  {%- if sd.title_en != blank -%}{%- assign hs_title = sd.title_en -%}{%- assign hs_hl = "" -%}{%- endif -%}
  {%- if sd.subtitle_en != blank -%}{%- assign hs_sub = sd.subtitle_en -%}{%- endif -%}
{%- endif -%}
{% assign n_tabs = 0 %}{% for tab in section_data.tabs %}{% if tab.label != blank and tab.product_ids.size > 0 %}{% assign n_tabs = n_tabs | plus: 1 %}{% endif %}{% endfor %}
{% if n_tabs > 0 %}
<section class="bp-theme bp-section bp-surface--{{ surface }} {{ hs_class }}{% if sd.wave_top %} bp-has-wave{% endif %}{% if sd.hide_on_mobile %} bp-hide-sm{% endif %}"{% if anchor != "" %} id="{{ anchor }}"{% endif %}{% if hs_title != blank %} aria-labelledby="bp-h-{{ sid }}"{% endif %} data-bp-currency="{{ cur }}" style="{% if surface == 'custom' %}--bp-surface-bg: {{ sd.bg_custom | default: '#ffffff' }};{% if sd.text_light %}--bp-surface-fg: #ffffff;{% endif %}{% endif %}{{ hs_style }}">
  {%- if sd.wave_top -%}<svg class="bp-wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 40V22c80-14 160-20 240-8s160 20 240 8 160-24 240-14 160 26 240 16 160-24 240-16 160 20 240 12v22z"/></svg>{%- endif -%}
  {% if sd.mascot != blank %}<img class="bp-pets__mascot" src="{{ sd.mascot }}" alt="" width="150" height="150" loading="lazy">{% endif %}
  <div class="bp-container" data-bp-rail-scope>
    <div class="bp-section-head">
<div class="bp-section-head__text">
  {%- if sd.kicker != blank -%}<p class="bp-kicker">{{ sd.kicker }}</p>{%- endif -%}
  {%- if hs_title != blank -%}
    <h2 class="bp-h2" id="bp-h-{{ sid }}">
      {%- if hs_hl != "" and hs_title contains hs_hl -%}
        {%- assign hl_html = '<span class="bp-hl">' | append: hs_hl | append: '</span>' -%}
        {{ hs_title | replace_first: hs_hl, hl_html }}
      {%- else -%}{{ hs_title }}{%- endif -%}
    </h2>
  {%- endif -%}
  {%- if hs_sub != blank -%}<p class="bp-lead">{{ hs_sub }}</p>{%- endif -%}
</div>
<div class="bp-rail__nav" hidden>
  <button type="button" class="bp-icon-btn bp-rail__btn" data-bp-rail="prev" aria-label="{% if is_en %}Previous{% else %}السابق{% endif %}"><svg class="bp-flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
  <button type="button" class="bp-icon-btn bp-rail__btn" data-bp-rail="next" aria-label="{% if is_en %}Next{% else %}التالي{% endif %}"><svg class="bp-flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
</div>
    </div>
    {% if n_tabs > 1 %}
      <div class="bp-tabs__list" role="tablist" aria-label="{{ hs_title }}">
        {% assign shown = 0 %}
        {% for tab in sd.tabs %}
          {% if tab.label != blank and tab.product_ids.size > 0 %}
            {% assign shown = shown | plus: 1 %}
            {% if is_en and tab.label_en != blank %}{% assign tl = tab.label_en %}{% else %}{% assign tl = tab.label %}{% endif %}
            <button type="button" class="bp-tab" role="tab" id="bp-tab-{{ sid }}-{{ forloop.index }}" aria-controls="bp-tp-{{ sid }}-{{ forloop.index }}" aria-selected="{% if shown == 1 %}true{% else %}false{% endif %}" tabindex="{% if shown == 1 %}0{% else %}-1{% endif %}">{{ tl }}</button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    {% assign shown = 0 %}
    {% for tab in sd.tabs %}
      {% if tab.label != blank and tab.product_ids.size > 0 %}
        {% assign shown = shown | plus: 1 %}
        <div class="bp-tabpanel" {% if n_tabs > 1 %}role="tabpanel" id="bp-tp-{{ sid }}-{{ forloop.index }}" aria-labelledby="bp-tab-{{ sid }}-{{ forloop.index }}" tabindex="0"{% endif %} {% if shown > 1 %}hidden{% endif %}>
          <div class="bp-rail">
            {% assign pm_ids = tab.product_ids %}{% assign pm_class = "bp-rail__track" %}{% assign pm_card = "" %}{% assign pm_limit = 16 %}
{%- comment -%} expects pm_ids (array), pm_class, pm_card, pm_limit {%- endcomment -%}
{%- assign pm_count = pm_ids.size -%}
{%- if pm_limit > 0 and pm_count > pm_limit -%}{%- assign pm_count = pm_limit -%}{%- endif -%}
{%- if pm_count > 5 -%}{%- assign pm_sk = 5 -%}{%- else -%}{%- assign pm_sk = pm_count -%}{%- endif -%}
<ul class="{{ pm_class }}" role="list" style="list-style:none;margin-block:0" data-bp-products="{{ pm_ids | join: ',' }}" data-bp-card="{{ pm_card }}" data-bp-limit="{{ pm_limit }}" data-bp-quick-add="{{ theme_data.show_quick_add }}" data-bp-wishlist="{{ theme_data.show_card_wishlist }}" data-bp-sale="{{ theme_data.show_sale_badge }}" data-bp-oos-label="{{ oos_label }}" data-bp-currency="{{ cur }}">
  {%- if pm_sk > 0 -%}{%- for i in (1..pm_sk) -%}<li><div class="bp-skeleton" aria-hidden="true"></div></li>{%- endfor -%}{%- endif -%}
</ul>
          </div>
          {% assign tile = tab %}
          {% if tab.link_url != blank or tab.category_id != blank %}
            <p style="margin:6px 0 0">
              {% assign tile_class = "bp-btn bp-btn--white bp-btn--sm" %}{% assign tile_style = "" %}
{%- assign t_href = tile.link_url | default: "" | strip -%}
{%- if t_href != "" -%}{%- assign t_tag = "a" -%}<a class="{{ tile_class }}" href="{{ t_href }}" style="{{ tile_style }}">
{%- elsif tile.category_id != blank -%}{%- assign t_tag = "a" -%}<a class="{{ tile_class }}" data-bp-link-entity="categories" data-bp-link-id="{{ tile.category_id }}" style="{{ tile_style }}">
{%- else -%}{%- assign t_tag = "div" -%}<div class="{{ tile_class }}" style="{{ tile_style }}">{%- endif -%}{% if is_en %}View all{% else %}شوف الكل{% endif %}</{{ t_tag }}>
            </p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}
