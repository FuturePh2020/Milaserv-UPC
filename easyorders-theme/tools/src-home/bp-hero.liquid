{% assign hs_key = "hero" %}{% assign hs_default_surface = "cream" %}{% assign hs_class = "bp-hero bp-dots-bg" %}{% assign hs_style = "" %}
{% comment %}@include hs-setup{% endcomment %}
{% if hs_title != blank %}
{% comment %}@include hs-open{% endcomment %}
  <div class="bp-container bp-hero__grid">
    <div class="bp-hero__copy">
      {% if sd.kicker != blank %}<p class="bp-kicker"><span class="bp-sticker">{{ sd.kicker }}</span></p>{% endif %}
      <h1 class="bp-h1 bp-hero__title" id="bp-h-{{ sid }}">
        {%- if hs_hl != "" and hs_title contains hs_hl -%}
          {%- assign hl_html = '<span class="bp-hl--pill">' | append: hs_hl | append: '</span>' -%}
          {{ hs_title | replace_first: hs_hl, hl_html }}
        {%- else -%}{{ hs_title }}{%- endif -%}
      </h1>
      {% if hs_sub != blank %}<p class="bp-lead">{{ hs_sub }}</p>{% endif %}
      <div class="bp-hero__ctas">
        {% assign lk = "primary" %}{% assign lk_class = "bp-btn bp-btn--blue" %}
{% comment %}@include hs-link{% endcomment %}
        {% assign lk = "secondary" %}{% assign lk_class = "bp-btn bp-btn--white" %}
{% comment %}@include hs-link{% endcomment %}
      </div>
      {% assign has_trust = false %}{% for it in sd.trust_items %}{% if it.text != blank %}{% assign has_trust = true %}{% endif %}{% endfor %}
      {% if has_trust %}
        <ul class="bp-hero__trust">
          {% for it in sd.trust_items %}{% if it.text != blank %}<li><span class="bp-hero__trust-icon" aria-hidden="true">{{ it.icon | default: "✔️" }}</span>{{ it.text }}</li>{% endif %}{% endfor %}
        </ul>
      {% endif %}
      {% if sd.show_doodles != false %}
        <svg class="bp-doodle bp-hero__doodle-arrow" viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 10c20 40 50 44 80 30"/><path d="M74 28l12 12-16 4"/></svg>
      {% endif %}
    </div>

    {% assign imgs = "" %}{% assign n_img = 0 %}
    {% if sd.image_1 != blank %}{% assign n_img = n_img | plus: 1 %}{% endif %}
    {% if sd.image_2 != blank %}{% assign n_img = n_img | plus: 1 %}{% endif %}
    {% if sd.image_3 != blank %}{% assign n_img = n_img | plus: 1 %}{% endif %}
    {% if sd.image_4 != blank %}{% assign n_img = n_img | plus: 1 %}{% endif %}
    {% if n_img > 0 %}
      <div class="bp-hero__art">
        <div class="bp-collage bp-collage--{{ n_img }}" style="--bp-collage-bg: {{ sd.collage_bg | default: '#A9D6FF' }}">
          {% for slot in (1..4) %}
            {% assign key = "image_" | append: slot %}
            {% if sd[key] != blank %}
              <div class="bp-collage__item{% if sd.image_fit != 'cover' %} bp-collage__item--contain{% endif %}">
                <img src="{{ sd[key] }}" alt="" width="600" height="600" {% if slot == 1 %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
              </div>
            {% endif %}
          {% endfor %}
        </div>
        {% if sd.sticker_1 != blank %}<span class="bp-sticker bp-hero__sticker bp-hero__sticker--1">{{ sd.sticker_1 }}</span>{% endif %}
        {% if sd.sticker_2 != blank %}<span class="bp-sticker bp-sticker--pink bp-hero__sticker bp-hero__sticker--2">{{ sd.sticker_2 }}</span>{% endif %}
        {% if sd.sticker_3 != blank %}<span class="bp-sticker bp-sticker--mint bp-hero__sticker bp-hero__sticker--3">{{ sd.sticker_3 }}</span>{% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% endif %}
