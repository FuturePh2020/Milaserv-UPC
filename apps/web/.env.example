# API_URL is used server-side by next.config.js's rewrites() to proxy
# /api/* HTTP requests to the NestJS API.
API_URL=http://localhost:4000

# NEXT_PUBLIC_API_ORIGIN is used client-side by the realtime WebSocket
# connection (apps/web/lib/use-realtime-channel.ts). Leave unset in
# production behind Nginx — the browser connects same-origin and Nginx
# proxies /api/socket.io to the API container. Set it when running the web
# app and API as separate local dev servers (no reverse proxy merging them
# onto one origin), since a browser WebSocket handshake can't go through
# Next's HTTP-only rewrites() the way plain fetch() calls do.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
