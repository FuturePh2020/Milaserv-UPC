NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lcrm:lcrm@localhost:5432/lcrm?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

VOIP_ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key-000

COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000

MAX_UPLOAD_SIZE_MB=20
