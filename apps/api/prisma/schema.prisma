// Milaserv360 — Phase 1 (Core Platform) schema.
// Blueprint references: §6 roles, §6.1 data scopes, §19 permissions & security,
// §8 shared engines (Audit, Timeline, Notification, Configuration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Blueprint §6.1 — PARTNER and BRANCH are modeled now, activated when their
/// master-data modules exist (Phase 2+).
enum DataScope {
  MY_RECORDS
  MY_TEAM
  DEPARTMENT
  MULTIPLE_TEAMS
  PARTNER
  BRANCH
  ALL_DATA
}

enum TeamMemberRole {
  MEMBER
  LEADER
  MANAGER
}

enum SettingScopeLevel {
  SYSTEM
  DEPARTMENT
  TEAM
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ── Identity & organization ─────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  nameAr              String
  nameEn              String
  phone               String?
  status              UserStatus @default(ACTIVE)
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  lastSignInAt        DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  roles         UserRole[]
  teams         TeamMember[]
  sessions      Session[]
  notifications Notification[]
  ticketsCreated     Ticket[]           @relation("ticketCreatedBy")
  ticketsResponsible Ticket[]           @relation("ticketResponsible")
  ticketOwnerships   TicketOwnership[]
  ticketUpdates      TicketUpdate[]
  kbContents         KbContent[]        @relation("kbOwner")
  coursesAdministered Course[]          @relation("courseAdmin")
  courseAssignments  CourseAssignment[] @relation("courseAssignee")
  lessonProgress     LessonProgress[]   @relation("lessonProgress")
  workSessions       WorkSession[]      @relation("workSessions")
  leadBatches        LeadBatch[]        @relation("leadBatches")
  assignedLeads      Lead[]             @relation("assignedLeads")
  leadCalls          LeadCall[]         @relation("leadCalls")
  telesalesOrders    TelesalesOrder[]   @relation("telesalesOrders")

  @@index([departmentId])
  @@index([status, deletedAt])
}

model Department {
  id        String    @id @default(cuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]
  teams Team[]
}

model Team {
  id           String     @id @default(cuid())
  nameAr       String
  nameEn       String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  members TeamMember[]
  tickets TicketTeam[]
  courseAssignments CourseAssignment[]
  workSessions      WorkSession[]

  @@index([departmentId])
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// ── Roles & permissions (blueprint §19) ─────────────────────────────

model Role {
  id        String    @id @default(cuid())
  /// Stable machine key (e.g. SUPER_ADMIN); system roles seeded from contracts.
  key       String    @unique
  nameAr    String
  nameEn    String
  /// System roles (blueprint §6) cannot be deleted.
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id      String @id @default(cuid())
  /// Stable key from @milaserv/contracts (e.g. "user.create"). Never renamed.
  key     String @unique
  module  String
  labelAr String
  labelEn String

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// Blueprint §19.1: permission = action + data scope.
  dataScope    DataScope  @default(MY_RECORDS)
  /// Explicit team ids when dataScope = MULTIPLE_TEAMS.
  scopeTeamIds String[]   @default([])
  /// Reserved for Phase 2+ (blueprint §19.1) — inactive until Branch/Partner masters exist.
  scopeBranchIds String[] @default([])
  scopePartnerIds String[] @default([])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ── Sessions ─────────────────────────────────────────────────────────

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  ip               String?
  userAgent        String?
  lastActivityAt   DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
}

// ── Configuration Engine (ADR-008) ──────────────────────────────────

model Setting {
  id         String            @id @default(cuid())
  key        String
  category   String
  valueType  SettingValueType
  /// JSON-encoded value; interpreted per valueType.
  value      Json
  scopeLevel SettingScopeLevel @default(SYSTEM)
  /// Department/Team id when scopeLevel is not SYSTEM; "" for SYSTEM scope
  /// (non-nullable so the composite unique constraint actually enforces).
  scopeId    String            @default("")
  labelAr    String
  labelEn    String
  updatedAt  DateTime          @updatedAt
  createdAt  DateTime          @default(now())

  @@unique([key, scopeLevel, scopeId])
  @@index([category])
}

// ── Audit Engine (blueprint §8 — append-only, immutable) ────────────

model AuditLog {
  id         String   @id @default(cuid())
  /// Nullable: system/seed actions have no user actor.
  actorId    String?
  /// Snapshot — remains meaningful even if the user is later renamed/removed.
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ── Timeline Engine (blueprint §8) ──────────────────────────────────

model TimelineEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  eventType  String
  actorId    String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ── Number Generator (ticketing spec §2) ────────────────────────────

model NumberSequence {
  key       String
  year      Int
  lastValue Int    @default(0)

  @@id([key, year])
}

// ── Attachment Engine foundation (blueprint §8, ticketing spec §2) ──

model Attachment {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([entityType, entityId])
}

// ── Minimal Branch Directory (ticketing spec §2; extended by Branch Center §16 later) ──

model Branch {
  id               String     @id @default(cuid())
  code             String     @unique
  nameAr           String
  nameEn           String
  city             String?
  phone            String?
  supervisorName   String?
  supervisorEmail  String?
  supervisorPhone  String?
  areaManagerName  String?
  areaManagerEmail String?
  status           UserStatus @default(ACTIVE)

  // ── §16.1 Branch Master extension (branch-center spec G1) ──
  storeCode           String?
  addressAr           String?
  addressEn           String?
  district            String?
  region              String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  mapUrl              String?
  phone2              String?
  phone3              String?
  branchTypeKey       String?
  branchType          BranchType? @relation(fields: [branchTypeKey], references: [key])
  deliveryCovered     Boolean?
  /// { "from": "HH:MM", "to": "HH:MM" } — absent = always open (spec G6).
  workingHours        Json?
  dutyPharmacist      String?
  districtManagerName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tickets Ticket[]

  @@index([region, city])
  @@index([branchTypeKey])
}

/// §16.2 — branch type catalog, seeded verbatim (editable).
model BranchType {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  branches Branch[]
}

// ── Ticketing configuration catalogs (spec §3 — data, not enums; ADR-008) ──

enum StatusKind {
  OPEN
  RESOLVED
  TERMINAL
}

model TicketType {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  categories  TicketCategory[]
  slaPolicies SlaPolicy[]
  tickets     Ticket[]
}

model TicketCategory {
  id     String     @id @default(cuid())
  typeId String
  type   TicketType @relation(fields: [typeId], references: [id])
  key    String
  nameAr String
  nameEn String
  order  Int        @default(0)
  active Boolean    @default(true)

  tickets Ticket[]

  @@unique([typeId, key])
}

model TicketUrgency {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  color  String  @default("#6b7280")
  order  Int     @default(0)
  active Boolean @default(true)

  slaPolicies SlaPolicy[]
  tickets     Ticket[]
}

model TicketStatus {
  id     String     @id @default(cuid())
  key    String     @unique
  nameAr String
  nameEn String
  kind   StatusKind @default(OPEN)
  color  String     @default("#6b7280")
  order  Int        @default(0)
  active Boolean    @default(true)

  transitionsFrom StatusTransition[] @relation("fromStatus")
  transitionsTo   StatusTransition[] @relation("toStatus")
  tickets         Ticket[]
}

/// Workflow-engine foundation: allowed transitions are configuration.
model StatusTransition {
  id                    String       @id @default(cuid())
  fromStatusId          String
  fromStatus            TicketStatus @relation("fromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId            String
  toStatus              TicketStatus @relation("toStatus", fields: [toStatusId], references: [id], onDelete: Cascade)
  requiredPermissionKey String?

  @@unique([fromStatusId, toStatusId])
}

model UpdateType {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  order  Int     @default(0)
  active Boolean @default(true)
  /// Waiting-type updates pause the SLA clock (spec US-4).
  pausesSla Boolean @default(false)

  ticketUpdates TicketUpdate[]
}

model ResolutionCategory {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  resolutions TicketResolution[]
}

model SlaPolicy {
  id                   String        @id @default(cuid())
  typeId               String
  type                 TicketType    @relation(fields: [typeId], references: [id])
  urgencyId            String
  urgency              TicketUrgency @relation(fields: [urgencyId], references: [id])
  firstResponseMinutes Int
  resolutionMinutes    Int
  warningThresholdPct  Int           @default(80)
  active               Boolean       @default(true)

  tickets Ticket[]

  @@unique([typeId, urgencyId])
}

// ── Tickets (ADR-003 universal engine; spec §4) ─────────────────────

enum SlaState {
  ON_TRACK
  WARNING
  BREACHED
  PAUSED
  MET
}

model Ticket {
  id                      String    @id @default(cuid())
  internalNumber          String    @unique
  customerComplaintNumber String    @unique
  typeId                  String
  type                    TicketType @relation(fields: [typeId], references: [id])
  categoryId              String
  category                TicketCategory @relation(fields: [categoryId], references: [id])
  urgencyId               String
  urgency                 TicketUrgency @relation(fields: [urgencyId], references: [id])
  statusId                String
  status                  TicketStatus @relation(fields: [statusId], references: [id])

  customerName            String
  customerPhone           String
  subject                 String
  description             String
  relatedOrderNo          String?
  /// §13 "Request Source" — nullable; filled for online issue/request tickets.
  requestSourceKey        String?
  requestSource           RequestSource? @relation(fields: [requestSourceKey], references: [key])
  customerVisitAt         DateTime?
  sapMaterialNo           String?
  itemNameAr              String?
  itemNameEn              String?

  branchId                String?
  branch                  Branch?   @relation(fields: [branchId], references: [id])
  /// ADR-007: immutable snapshot of supervisor data at creation time.
  branchSupervisorSnapshot Json?

  /// ADR-004: creator never changes.
  createdById             String
  createdBy               User      @relation("ticketCreatedBy", fields: [createdById], references: [id])
  responsibleId           String?
  responsible             User?     @relation("ticketResponsible", fields: [responsibleId], references: [id])
  resolvedById            String?
  resolvedAt              DateTime?
  closedById              String?
  closedAt                DateTime?
  reopenCount             Int       @default(0)
  lastCustomerResponseAt  DateTime?

  // SLA (Sprint 4)
  slaPolicyId             String?
  slaPolicy               SlaPolicy? @relation(fields: [slaPolicyId], references: [id])
  firstResponseDueAt      DateTime?
  resolutionDueAt         DateTime?
  slaState                SlaState  @default(ON_TRACK)
  slaPausedAt             DateTime?
  slaPausedTotalMinutes   Int       @default(0)
  firstRespondedAt        DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  teams      TicketTeam[]
  ownerships TicketOwnership[]
  updates    TicketUpdate[]
  resolution TicketResolution?

  @@index([statusId, urgencyId])
  @@index([responsibleId])
  @@index([createdById])
  @@index([branchId])
  @@index([createdAt])
}

/// §9.9: directed teams are multi-select.
model TicketTeam {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([ticketId, teamId])
  @@index([teamId])
}

/// §9.5: complete responsibility history.
model TicketOwnership {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  assignedById String
  reason       String?
  fromAt       DateTime  @default(now())
  toAt         DateTime?

  @@index([ticketId, fromAt])
}

/// §9.6: immutable operational updates.
model TicketUpdate {
  id               String     @id @default(cuid())
  ticketId         String
  ticket           Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId         String
  author           User       @relation(fields: [authorId], references: [id])
  updateTypeId     String
  updateType       UpdateType @relation(fields: [updateTypeId], references: [id])
  directedToTeamId String?
  body             String
  createdAt        DateTime   @default(now())

  @@index([ticketId, createdAt])
}

/// §9.7: mandatory resolution record (ADR-005).
model TicketResolution {
  id                   String             @id @default(cuid())
  ticketId             String             @unique
  ticket               Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  summary              String
  rootCause            String
  actionTaken          String
  finalSolution        String
  resolutionCategoryId String
  resolutionCategory   ResolutionCategory @relation(fields: [resolutionCategoryId], references: [id])
  customerInformed     Boolean
  resolvedById         String
  resolvedAt           DateTime           @default(now())
}

// ── Knowledge Base Basic (blueprint §10; spec docs/specs/kb-basic-spec-v1.0.md) ──

enum KbKind {
  SOP
  ADDED_SOP
  DAILY_NOTE
  VIDEO
  PDF
  WORD
  FLOW_CHART
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbContent {
  id        String   @id @default(cuid())
  /// Version group: equals the first version's id (§10.4).
  rootId    String
  version   Int      @default(1)
  kind      KbKind
  titleAr   String
  titleEn   String
  summaryAr String?
  summaryEn String?
  body      String?
  videoUrl  String?
  ownerId   String
  owner     User     @relation("kbOwner", fields: [ownerId], references: [id])
  status    KbStatus @default(DRAFT)
  publishAt DateTime?
  expiryAt  DateTime?
  /// Published+public content is visible to every kb.view holder (spec B3).
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  lessons CourseLesson[]

  @@unique([rootId, version])
  @@index([status, kind])
}

model Course {
  id            String    @id @default(cuid())
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  /// §10.2 Course Admin.
  courseAdminId String
  courseAdmin   User      @relation("courseAdmin", fields: [courseAdminId], references: [id])
  status        KbStatus  @default(DRAFT)
  /// §10.3 Due Date (default for assignments without their own).
  dueAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lessons     CourseLesson[]
  assignments CourseAssignment[]
}

model CourseLesson {
  id              String     @id @default(cuid())
  courseId        String
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Int
  titleAr         String
  titleEn         String
  contentId       String?
  content         KbContent? @relation(fields: [contentId], references: [id])
  videoUrl        String?
  durationSeconds Int?
  createdAt       DateTime   @default(now())

  progress LessonProgress[]

  @@unique([courseId, order])
}

/// §10.2: assignment to a team OR a specific user (exactly one target).
model CourseAssignment {
  id           String    @id @default(cuid())
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation("courseAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  dueAt        DateTime?
  createdAt    DateTime  @default(now())

  @@index([courseId])
  @@index([teamId])
  @@index([userId])
}

/// §10.3 progress indicators; course % derived from completed lessons.
model LessonProgress {
  id               String       @id @default(cuid())
  lessonId         String
  lesson           CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation("lessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  positionSeconds  Int          @default(0)
  watchTimeSeconds Int          @default(0)
  completedAt      DateTime?
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  @@unique([lessonId, userId])
  @@index([userId, updatedAt])
}

// ── Notification Engine foundation (blueprint §8) ───────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  /// Structured payload for deep-linking (entityType/entityId, …).
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ── Break Tracker & Workforce (blueprint §11) ───────────────────────

enum WorkSessionStatus {
  ACTIVE
  ENDED
}

enum SessionEndReason {
  MANUAL
  AUTO
}

enum WorkPeriodType {
  WORK
  BREAK
  IDLE
}

/// One work shift (§11.1). At most one ACTIVE session per user — enforced by
/// a partial unique index added in the migration SQL.
model WorkSession {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("workSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// Primary-team snapshot at session start (live view + concurrency unit).
  teamId    String?
  team      Team?             @relation(fields: [teamId], references: [id])
  status    WorkSessionStatus @default(ACTIVE)
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  endReason SessionEndReason?

  lastHeartbeatAt DateTime @default(now())
  lastActivityAt  DateTime @default(now())

  /// Rollups of closed periods; the open period is added at read time.
  activeSeconds Int @default(0)
  idleSeconds   Int @default(0)
  breakSeconds  Int @default(0)

  periods WorkPeriod[]

  @@index([userId, status])
  @@index([status, lastHeartbeatAt])
  @@index([teamId, status])
}

/// §11.1 "تسجيل بداية ونهاية كل فترة" — the auditable period record.
model WorkPeriod {
  id        String         @id @default(cuid())
  sessionId String
  session   WorkSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      WorkPeriodType
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId, endedAt])
  @@index([type, endedAt, startedAt])
}

// ── Customer Care performance (blueprint §12.1/§12.2, Sprint 7) ─────

enum MetricAggregation {
  SUM
  AVG
}

enum MetricSource {
  YEASTAR
  TICKETING
  TELESALES
}

enum PerfScopeType {
  USER
  TEAM
}

enum TargetPeriod {
  DAILY
  MONTHLY
  YEARLY
}

/// §12.1 KPI catalog as data (ADR-008, spec D2).
model PerformanceMetricDef {
  id             String            @id @default(cuid())
  key            String            @unique
  nameAr         String
  nameEn         String
  /// count | seconds | percent — display formatting hint.
  unit           String
  /// How daily rows combine into a period actual (spec D2).
  aggregation    MetricAggregation
  source         MetricSource
  /// false for Missed/Abandoned/AVG Handle/Hold/Wait (spec D6).
  higherIsBetter Boolean           @default(true)
  sortOrder      Int               @default(0)

  values  MetricValue[]
  targets PerformanceTarget[]
}

/// One KPI value per day per user/team — the ingestion target (spec D1).
model MetricValue {
  id         String               @id @default(cuid())
  metricDate DateTime             @db.Date
  scopeType  PerfScopeType
  scopeId    String
  metricKey  String
  metric     PerformanceMetricDef @relation(fields: [metricKey], references: [key])
  value      Decimal              @db.Decimal(14, 2)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([metricDate, scopeType, scopeId, metricKey])
  @@index([scopeType, scopeId, metricDate])
}

/// §12.2: targets per employee or team, daily/monthly/yearly.
model PerformanceTarget {
  id          String               @id @default(cuid())
  scopeType   PerfScopeType
  scopeId     String
  metricKey   String
  metric      PerformanceMetricDef @relation(fields: [metricKey], references: [key])
  period      TargetPeriod
  targetValue Decimal              @db.Decimal(14, 2)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([scopeType, scopeId, metricKey, period])
  @@index([scopeType, scopeId])
}

// ── CRM, Leads & Telesales (blueprint §14) ──────────────────────────

enum LeadStatus {
  NEW
  ASSIGNED
  CLOSED
}

enum TelesalesOrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// §14.2 — call result catalog, seeded verbatim.
model CallStatus {
  id        String @id @default(cuid())
  key       String @unique
  nameAr    String
  nameEn    String
  sortOrder Int    @default(0)

  calls LeadCall[]
}

/// §14.3 — disposition catalog with behavior flags (spec E3, ADR-008).
model LeadDisposition {
  id                 String  @id @default(cuid())
  key                String  @unique
  nameAr             String
  nameEn             String
  /// Lead is closed after this disposition.
  closesLead         Boolean @default(false)
  /// rescheduledAt becomes mandatory with this disposition.
  requiresReschedule Boolean @default(false)
  /// An order payload becomes mandatory (Order Created).
  createsOrder       Boolean @default(false)
  sortOrder          Int     @default(0)

  calls LeadCall[]
}

/// §14.4 — order type catalog, seeded verbatim.
model TelesalesOrderType {
  id        String @id @default(cuid())
  key       String @unique
  nameAr    String
  nameEn    String
  sortOrder Int    @default(0)

  orders TelesalesOrder[]
}

/// One uploaded lead file (§14.1: source/partner/campaign set at upload).
model LeadBatch {
  id            String   @id @default(cuid())
  fileName      String
  leadSource    String
  /// Snapshot string until the Partner master exists (spec E6).
  partnerName   String?
  campaign      String?
  uploadedById  String
  uploadedBy    User     @relation("leadBatches", fields: [uploadedById], references: [id])
  importedCount Int      @default(0)
  skippedCount  Int      @default(0)
  createdAt     DateTime @default(now())

  leads Lead[]
}

model Lead {
  id      String     @id @default(cuid())
  batchId String?
  batch   LeadBatch? @relation(fields: [batchId], references: [id])

  name        String
  /// Normalized digits — duplicate-detection key (spec E2).
  phone       String
  city        String?
  notes       String?
  leadSource  String
  partnerName String?
  campaign    String?

  status               LeadStatus @default(NEW)
  assignedToId         String?
  assignedTo           User?      @relation("assignedLeads", fields: [assignedToId], references: [id])
  assignedAt           DateTime?
  /// Follow-up due time (§14.1 Reschedule); lead returns via /next when due.
  rescheduledAt        DateTime?
  lastCallAt           DateTime?
  closedAt             DateTime?
  closedDispositionKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls  LeadCall[]
  orders TelesalesOrder[]

  @@index([status, rescheduledAt])
  @@index([assignedToId, status])
  @@index([phone])
}

/// §14.1 — every call attempt: result, duration, disposition.
model LeadCall {
  id              String          @id @default(cuid())
  leadId          String
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId         String
  agent           User            @relation("leadCalls", fields: [agentId], references: [id])
  callStatusKey   String
  callStatus      CallStatus      @relation(fields: [callStatusKey], references: [key])
  dispositionKey  String
  disposition     LeadDisposition @relation(fields: [dispositionKey], references: [key])
  durationSeconds Int             @default(0)
  notes           String?
  rescheduledAt   DateTime?
  orderId         String?
  order           TelesalesOrder? @relation(fields: [orderId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([agentId, createdAt])
  @@index([leadId, createdAt])
}

/// Performance-readiness order record (spec E7) — not the pharmacy pipeline.
model TelesalesOrder {
  id            String               @id @default(cuid())
  number        String               @unique
  leadId        String?
  lead          Lead?                @relation(fields: [leadId], references: [id])
  customerName  String
  customerPhone String
  orderTypeKey  String
  orderType     TelesalesOrderType   @relation(fields: [orderTypeKey], references: [key])
  value         Decimal              @db.Decimal(14, 2)
  status        TelesalesOrderStatus @default(OPEN)
  createdById   String
  createdBy     User                 @relation("telesalesOrders", fields: [createdById], references: [id])
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  calls LeadCall[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

// ── Online Operation & Ordering (blueprint §13) ─────────────────────

enum IntegrationOpStatus {
  PENDING
  SUCCEEDED
  FAILED
  DEAD
}

/// §13 "Order Source" — editable catalog (spec F3).
model OrderSource {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  orders OnlineOrder[]
}

/// §13 "Request Source" — editable catalog (spec F3).
model RequestSource {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  tickets Ticket[]
}

/// §13 "Daily Orders" — integration-owned records ingested via the
/// Integration Layer slot (spec F4). Issues/requests link through the
/// ticket engine's relatedOrderNo (§9.4).
model OnlineOrder {
  id             String      @id @default(cuid())
  externalNumber String      @unique
  orderSourceKey String
  orderSource    OrderSource @relation(fields: [orderSourceKey], references: [key])
  orderedAt      DateTime
  customerName   String?
  customerPhone  String?
  value          Decimal?    @db.Decimal(14, 2)
  /// Status as reported by the Ordering System (informational).
  externalStatus String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([orderedAt])
  @@index([orderSourceKey, orderedAt])
}

/// §13 Retry Queue + §21.1 integration standard (spec F5). Callers enqueue
/// and never block on the external system (§22 Availability).
model IntegrationOperation {
  id             String              @id @default(cuid())
  integrationKey String
  operation      String
  payload        Json
  status         IntegrationOpStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextRetryAt    DateTime            @default(now())
  lastError      String?
  succeededAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([integrationKey, createdAt])
}

// ── United Pharmacy Center — DIC (blueprint §15) ────────────────────

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// §15.2 item classifications — catalog (feed values; editable).
model DrugItemType {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  drugs Drug[]
}

/// §15.3 — MEENA/TAWUNIYA/BUPA seeded; additional companies are inserts.
model InsuranceCompany {
  id     String  @id @default(cuid())
  key    String  @unique
  nameAr String
  nameEn String
  active Boolean @default(true)

  coverages DrugCoverage[]
}

/// §18 Drug master — canonical feed: the company's Mapping export (spec H1).
model Drug {
  id            String  @id @default(cuid())
  materialNo    String  @unique
  oldMaterialNo String?
  ean           String?
  gtin          String?
  sfdaCode      String?
  /// §15.2 Coded/Not Coded — SFDA code present (spec H4).
  coded         Boolean @default(false)

  nameEn       String
  nameAr       String?
  brand        String?
  division     String?
  category     String?
  subCategory  String?
  className    String?
  subClassName String?

  price        Decimal? @db.Decimal(12, 2)
  priceWithTax Decimal? @db.Decimal(12, 2)

  itemTypeKey  String?
  itemType     DrugItemType? @relation(fields: [itemTypeKey], references: [key])
  raqeeb       Boolean       @default(false)
  acuteChronic String?

  /// Pharmacist-maintained fields (spec H5) — edited via the 15.3 approval flow.
  activeIngredient String?
  usage            String?
  offers           String?
  note             String?

  /// {city: qty} snapshot from the feed's city columns (spec H6).
  availability Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alternatives   DrugAlternative[]
  crossSells     DrugCrossSell[]
  coverages      DrugCoverage[]
  changeRequests DrugChangeRequest[]

  @@index([nameEn])
  @@index([nameAr])
  @@index([brand])
}

/// §15.2 Alternatives — Mapped Product 1..22 (ordered).
model DrugAlternative {
  id            String @id @default(cuid())
  drugId        String
  drug          Drug   @relation(fields: [drugId], references: [id], onDelete: Cascade)
  altMaterialNo String
  order         Int    @default(0)

  @@unique([drugId, altMaterialNo])
}

/// §15.2 Cross-Selling — Combined Products column (spec H7).
model DrugCrossSell {
  id         String @id @default(cuid())
  drugId     String
  drug       Drug   @relation(fields: [drugId], references: [id], onDelete: Cascade)
  materialNo String

  @@unique([drugId, materialNo])
}

/// §15.3 coverage mapping rows.
model DrugCoverage {
  id         String           @id @default(cuid())
  drugId     String
  drug       Drug             @relation(fields: [drugId], references: [id], onDelete: Cascade)
  companyKey String
  company    InsuranceCompany @relation(fields: [companyKey], references: [key])
  covered    Boolean
  note       String?
  updatedAt  DateTime         @updatedAt

  @@unique([drugId, companyKey])
  @@index([companyKey, covered])
}

/// §15.3 Approval Workflow for Master Data Changes (spec H8).
model DrugChangeRequest {
  id            String              @id @default(cuid())
  drugId        String
  drug          Drug                @relation(fields: [drugId], references: [id], onDelete: Cascade)
  /// Proposed patch: { field: newValue } for the H5 editable fields/coverage.
  patch         Json
  status        ChangeRequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNote  String?
  createdAt     DateTime            @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}
