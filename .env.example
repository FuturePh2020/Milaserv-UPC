# ── Infrastructure (docker compose) ────────────────────────────────
POSTGRES_USER=milaserv
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=milaserv360
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ── API (apps/api) ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://milaserv:change-me-postgres@localhost:5432/milaserv360?schema=public
REDIS_URL=redis://:change-me-redis@localhost:6379

# JWT — generate long random secrets per environment (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Security policy (infrastructure-level; business values live in Settings)
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# First Super Admin — created by the seed, forced password reset on first login
SEED_ADMIN_EMAIL=admin@milaserv360.local
SEED_ADMIN_PASSWORD=change-me-admin

# ── Web (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
