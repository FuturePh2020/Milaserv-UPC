# ALKHAYR deployment settings (copy to deploy/.env; NOT secret — secrets are files in SECRETS_DIR).
ALKHAYR_VERSION=17.0.0-rc1
# Public host name (DNS A/AAAA record must point to this server for TLS_MODE=acme).
PUBLIC_HOST=portal.example.com
TLS_MODE=acme
ACME_EMAIL=ops@example.com
HTTP_PORT=80
# Private network (change only if 172.30.10.0/24 is already used on this host).
APP_NET_SUBNET=172.30.10.0/24
PROXY_IP=172.30.10.2
APP_IP=172.30.10.3
HTTPS_PORT=443
# Directory holding the secret FILES (owned by uid 1000, mode 0400; see docs/DEPLOYMENT_AR.md).
SECRETS_DIR=./secrets
# Provisional backup schedule (the 24 h RPO / 2 h RTO are NOT business-approved).
BACKUP_SCHEDULE=02:17
BACKUP_TZ=Africa/Cairo
BACKUP_KEEP=14
BACKUP_RETRIES=2
# Off-server copy (S3-compatible). Leave all empty until an authorized destination exists (blocker B-2).
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=alkhayr/prod/
OFFSITE_S3_PATH_STYLE=false
OFFSITE_S3_ACCESS_KEY_FILE=
OFFSITE_S3_SECRET_KEY_FILE=
