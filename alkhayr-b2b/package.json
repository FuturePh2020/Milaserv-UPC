{
  "name": "alkhayr-b2b",
  "version": "0.1.0",
  "private": true,
  "description": "ALKHAYR independent Arabic B2B wholesale ordering portal",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "db:status": "node --env-file-if-exists=.env dist/server/cli.js db:status",
    "db:init": "node --env-file-if-exists=.env dist/server/cli.js db:init",
    "db:migrate": "node --env-file-if-exists=.env dist/server/cli.js db:migrate",
    "setup-admin": "node --env-file-if-exists=.env dist/server/cli.js setup-admin",
    "cli": "node --env-file-if-exists=.env dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "node scripts/build.mjs && node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
