# ALKHAYR B2B — environment configuration template.
# Copy to .env for local development. NEVER commit .env. Empty or placeholder
# secrets are refused in production; production will not start without real values.

# development | test | production
NODE_ENV=development

# Bind address and port of the Node process. In production bind to 127.0.0.1 or
# a private container network; only the HTTPS reverse proxy is exposed.
HOST=127.0.0.1
PORT=3000

# Exact public origin (scheme://host[:port], no path). Must be https:// in production.
# Requests whose Host header does not match this origin are rejected.
APP_ORIGIN=http://localhost:3000

# Persistent local directories (not NFS). Used from stage 02 / stage 15.
DATA_DIR=./data
BACKUP_DIR=./backups

# Secrets: 32 random bytes, base64url. Generate locally, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# APP_SECRET and BACKUP_KEY must be different. Keep BACKUP_KEY off-host as well.
# Required in production; optional in development until the stages that use them.
APP_SECRET=
BACKUP_KEY=

# Comma-separated exact IP addresses of trusted reverse proxies. Empty = trust none
# (X-Forwarded-For ignored).
TRUST_PROXY=

# debug | info | warn | error
LOG_LEVEL=info

# HTTP hardening (milliseconds)
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
